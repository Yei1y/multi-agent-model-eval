# Mock mode needs no key. Run: python scripts/run_demo.py --mode mock
LLM_MODE=mock

# Real mode: any OpenAI-compatible /chat/completions endpoint.
# Example: Volcengine Ark, DeepSeek, vLLM or an internal gateway.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: Ark/Doubao thinking mode (disabled|enabled|auto). Leave blank for other providers.
LLM_THINKING=

# Real comparison: the candidate models interrogated in
# data/scenarios/ecommerce_real_compare.yaml (same endpoint by default).
# Each scenario model may also override base_url_env / api_key_env.
LLM_MODEL_B=
LLM_MODEL_C=
